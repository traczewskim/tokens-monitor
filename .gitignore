# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local dataset dumps.
# `ccusage.py --json` writes the parsed dataset, which contains real project
# paths, session ids and usage figures from the machine it ran on.
# Never commit one.
/*.json
usage-*.json
ccusage-*.json
dump*.json
export/
data/

# Screenshots and captures.
# A screenshot taken against real transcripts shows real project directory
# names and usage figures. Only commit images rendered from synthetic data
# (see tools/make_demo_data.py); docs/ holds those and is allowed through.
screenshot*.png
screenshot*.jpg
screenshot*.jpeg
capture*/
!docs/screenshot.png
!docs/screenshot-dark.png

# Claude Code transcripts. These contain full conversation text.
# They live in ~/.claude/projects and must never end up in this repo,
# including any copy made for testing.
*.jsonl
.env

# Local agent/session state. Never publish this.
.claude/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

#!/usr/bin/env bash
#
# tokens-monitor pre-commit guard — fast, deterministic leak checks only.
#
# The /security-review pass lives in .githooks/pre-push, so committing stays
# instant and the AI review runs once per push instead of once per commit.
#
# Enable with:
#     git config core.hooksPath .githooks
#
# Bypass with `git commit --no-verify`; note that pre-push re-runs these same
# checks over everything being published, so a bypassed commit is still
# caught before it leaves the machine.
#
set -uo pipefail
. "$(dirname "$0")/lib/guard.sh"

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

diff=$(git diff --cached --diff-filter=ACMR -- . ':(exclude)*.png' ':(exclude)*.jpg' 2>/dev/null)

guard_run "$files" "$diff" ":"

if [ "$guard_fail" -ne 0 ]; then
  say ""
  say "${DIM}Commit aborted. Fix the above, or bypass with --no-verify.${OFF}"
  exit 1
fi
exit 0

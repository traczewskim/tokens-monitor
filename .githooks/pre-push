#!/usr/bin/env bash
#
# tokens-monitor pre-push guard.
#
# Push is the point where things actually become public, so this is where the
# /security-review pass runs. It also re-runs the deterministic leak checks
# over the whole range being published, which closes the gap left by
# `git commit --no-verify`.
#
# Enable with:
#     git config core.hooksPath .githooks
#
# Escape hatches:
#   SKIP_AI_REVIEW=1 git push ...   skip the review, keep the leak checks
#   git push --no-verify            skip the hook entirely
#
# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> per ref.
#
set -uo pipefail
. "$(dirname "$0")/lib/guard.sh"

ZERO="0000000000000000000000000000000000000000"
all_diff=""
checked=0

# Every commit is inspected on its OWN tree.
#
# Scanning only the net range diff would miss a file that is added in one
# commit and deleted in a later one: it vanishes from `git diff base..tip`
# but its blob is still published in history. So iterate commit by commit.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion

  # Resolve the range. git reports the remote's sha from its ls-remote, and
  # that object is not necessarily present locally (force-push after the
  # remote advanced, a second remote, a shallow clone). Falling through on a
  # failed rev-list would silently check nothing, so verify it first.
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    commits=$(git rev-list --reverse "${remote_sha}..${local_sha}" 2>/dev/null)
    rc=$?
  else
    # New branch, or a base we cannot resolve: check everything on this ref
    # that no remote already has.
    commits=$(git rev-list --reverse "$local_sha" --not --remotes 2>/dev/null)
    rc=$?
  fi

  if [ $rc -ne 0 ]; then
    bad "could not determine which commits $local_ref would publish.
        Refusing rather than pushing unchecked content."
    continue
  fi
  [ -z "$commits" ] && continue

  for sha in $commits; do
    files=$(git show --pretty=format: --name-only --diff-filter=ACMR -m --first-parent "$sha" 2>/dev/null \
            | grep -v '^$' | sort -u)
    [ -z "$files" ] && continue
    diff=$(git show --pretty=format: --diff-filter=ACMR -m --first-parent "$sha" \
             -- . ':(exclude)*.png' ':(exclude)*.jpg' 2>/dev/null)
    checked=$((checked + 1))
    guard_run "$files" "$diff" "$sha:"
    all_diff+=$'\n'"$diff"
  done
done

if [ "$guard_fail" -ne 0 ]; then
  say ""
  say "${DIM}Push aborted. Fix the above, or bypass with --no-verify.${OFF}"
  exit 1
fi
[ "$checked" -eq 0 ] && exit 0

# -- /security-review over the range -----------------------------------------
if [ "${SKIP_AI_REVIEW:-0}" = "1" ]; then
  warn "security review skipped (SKIP_AI_REVIEW=1)"
  exit 0
fi
if ! command -v claude >/dev/null 2>&1; then
  warn "claude CLI not found — skipping the security review stage."
  exit 0
fi
[ -z "$(printf '%s' "$all_diff" | tr -d '[:space:]')" ] && exit 0

say "${DIM}Running /security-review on the commits being pushed (ctrl-c to skip)...${OFF}"

prompt=$(cat <<PROMPT
Run the /security-review workflow against the diff below, which is the set of
commits about to be pushed.

Follow the security-review skill's rules: report only HIGH and MEDIUM severity,
high-confidence, concretely exploitable vulnerabilities INTRODUCED by this diff.
Apply its exclusions - no DoS, no rate limiting, no resource exhaustion, no
findings in documentation files, no lack-of-hardening findings, no theoretical
issues. Do not report anything you are less than 80% confident is exploitable.

Context: tokens-monitor is a zero-dependency local dashboard that parses Claude
Code JSONL transcripts and serves a panel bound to 127.0.0.1. It validates the
Host header against DNS rebinding and escapes transcript-derived strings before
innerHTML. This is a PUBLIC repository, so leaking real paths, usernames or
transcript content into committed files is itself a HIGH severity finding.

Reply with findings in the skill's markdown format, then a final line that is
exactly one of:
VERDICT: PASS
VERDICT: FAIL

Use FAIL only if at least one HIGH or MEDIUM finding survives the skill's own
false-positive filtering.

--- DIFF BEING PUSHED ---
$(printf '%s' "$all_diff" | head -c 180000)
PROMPT
)

out=$(printf '%s' "$prompt" | timeout "${AI_REVIEW_TIMEOUT:-600}" claude -p 2>/dev/null)
rc=$?

if [ $rc -ne 0 ] || [ -z "$out" ]; then
  say ""
  if [ $rc -eq 124 ]; then
    warn "security review TIMED OUT after ${AI_REVIEW_TIMEOUT:-600}s."
  else
    warn "security review did not complete (exit $rc)."
  fi
  warn "THIS PUSH WAS NOT REVIEWED. The leak checks above did pass."
  warn "Re-run manually, or raise AI_REVIEW_TIMEOUT."
  say ""
  exit 0
fi

if printf '%s' "$out" | grep -q '^VERDICT: FAIL'; then
  say ""
  say "$out"
  say ""
  bad "/security-review reported findings in the commits being pushed."
  say "${DIM}Fix them, or bypass with: SKIP_AI_REVIEW=1 git push ...${OFF}"
  exit 1
fi

ok "/security-review passed"
exit 0
